# ═══════════════════════════════════════════════════════════════════════════════
# AI Provider Selection & API Keys (NEW IN V1.1)
# ═══════════════════════════════════════════════════════════════════════════════
# AI_PROVIDER: Choose which AI service to use
#   Options: "claude", "openai", "deepseek"
#   Default: "claude"
#   Recommendation: Start with "openai" for lowest cost, or "claude" for reliability
AI_PROVIDER=claude

# Claude API Configuration (Anthropic)
# Get your API key from: https://console.anthropic.com
# Pricing: $0.80/MTok input, $4/MTok output (using Haiku model)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
# Pricing: $0.15/MTok input, $0.60/MTok output (gpt-4o-mini is very cheap!)
OPENAI_API_KEY=sk-xxxxx-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# DeepSeek API Configuration
# Get your API key from: https://platform.deepseek.com
# Pricing: $0.27/MTok input, $1.1/MTok output
DEEPSEEK_API_KEY=sk-xxxxx-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# ═══════════════════════════════════════════════════════════════════════════════
# Application
# ═══════════════════════════════════════════════════════════════════════════════
ENVIRONMENT=local
DEBUG=True
LOG_LEVEL=INFO
APP_NAME=Cloud AI Trading
APP_VERSION=1.0.0

# ═══════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cloudaitrading
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/cloudaitrading
DB_NAME=cloudaitrading
DB_USER=postgres
DB_PASSWORD=change_me_in_production
POSTGRES_DB=cloudaitrading
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ═══════════════════════════════════════════════════════════════════════════════
# Redis Configuration
# ═══════════════════════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ═══════════════════════════════════════════════════════════════════════════════
# Security & Encryption
# ═══════════════════════════════════════════════════════════════════════════════
SECRET_KEY=your-secret-key-here-min-32-chars-required-for-production
# ENCRYPTION_KEY: 必须是合法的 base64 Fernet key(32 字节 url-safe base64)。
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ═══════════════════════════════════════════════════════════════════════════════
# Celery Configuration
# ═══════════════════════════════════════════════════════════════════════════════
ANALYSIS_INTERVAL_MINUTES=3

# ═══════════════════════════════════════════════════════════════════════════════
# Exchange APIs
# ═══════════════════════════════════════════════════════════════════════════════
# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Alpaca US Stocks
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Default settings
DEFAULT_SIMULATE_BALANCE=10000.0
BINANCE_FEE_RATE=0.001
ALPACA_FEE_RATE=0.0

# ═══════════════════════════════════════════════════════════════════════════════
# Telegram Notifications
# ═══════════════════════════════════════════════════════════════════════════════
# Get your bot token from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ═══════════════════════════════════════════════════════════════════════════════
# System Monitoring
# ═══════════════════════════════════════════════════════════════════════════════
SYSTEM_METRICS_COLLECTION_INTERVAL_SECONDS=60
SYSTEM_TASK_HEALTH_CHECK_INTERVAL_SECONDS=300
SYSTEM_LOG_RETENTION_DAYS=30
SYSTEM_METRICS_RETENTION_DAYS=30
SYSTEM_CPU_WARNING_THRESHOLD=80.0
SYSTEM_MEMORY_WARNING_THRESHOLD=85.0
SYSTEM_DISK_CRITICAL_THRESHOLD=90.0

# ═══════════════════════════════════════════════════════════════════════════════
# CORS Settings
# ═══════════════════════════════════════════════════════════════════════════════
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ═══════════════════════════════════════════════════════════════════════════════
# Cost Optimization Tips (v1.1)
# ═══════════════════════════════════════════════════════════════════════════════
# 1. Signal Filtering:
#    The system now filters weak signals and only calls AI when:
#    - 3+ signals align (all BUY or all SELL)
#    - OR one signal has confidence > 75%
#    This reduces API calls by 60-80% while maintaining quality.
#
# 2. Frequency Adjustment:
#    Default: generate_trading_signals runs every 15 minutes (900 seconds)
#    The system will skip AI analysis for weak signals anyway, so you get
#    good coverage with minimal cost.
#
# 3. Provider Recommendations:
#    - Claude Haiku:  $0.80/MTok input, $4/MTok output (good balance)
#    - OpenAI mini:   $0.15/MTok input, $0.60/MTok output (VERY CHEAP!)
#    - DeepSeek:      $0.27/MTok input, $1.1/MTok output (good value)
#
# 4. Expected Daily Costs (with 5 symbols, 15-min frequency, signal filtering):
#    - Claude Haiku:  ~$0.40-$0.60/day
#    - OpenAI mini:   ~$0.08-$0.12/day
#    - DeepSeek:      ~$0.20-$0.30/day
